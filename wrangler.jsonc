{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rough-night-ed55",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
